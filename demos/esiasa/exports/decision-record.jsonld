  "conclave:evidence": [
    {
      "@id": "urn:conclave:cid:E0=E1",
      "conclave:evidenceId": "E1",
      "conclave:handling": "Public demo input; proves only what the sample inventory records.",
      "conclave:sensitivity": "public",
      "conclave:source": "Siaya County Roads Department inventory workbook (FY2025 close)",
      "conclave:sourceKind": "policy",
      "description": "The county's active feeder-road inventory records 412 route segments totalling 1,360 km under the roads department."
    },
    {
      "@id": "urn:conclave:cid:E1=E2",
      "conclave:evidenceId": "E2",
      "conclave:handling": "Public demo input; demonstrates the reactive-spend pattern only.",
      "conclave:sensitivity": "public",
      "conclave:source": "County treasury FY2025 maintenance vote outturn",
      "conclave:sourceKind": "budget",
      "description": "Reactive pothole patching consumed 61% of the FY2025 feeder-road maintenance vote against a 40% plan, with no recorded closure rate per ward."
    },
    {
      "@id": "urn:conclave:cid:E2=E3",
      "conclave:evidenceId": "E3",
      "conclave:handling": "Public demo input; durability findings illustrate, not certify.",
      "conclave:sensitivity": "public",
      "conclave:source": "County audit office FY2024 roads sampling report",
      "conclave:sourceKind": "audit",
      "description": "The 2024 county audit sampled 18 completed patching works and found 11 degraded below usable surface within six months of handover."
    },
    {
      "@id": "urn:conclave:cid:E3=E4",
      "conclave:evidenceId": "E4",
      "conclave:handling": "Public demo input; precedent value only.",
      "conclave:sensitivity": "public",
      "conclave:source": "Neighbouring county roads tender board summary",
      "conclave:sourceKind": "benchmark",
      "description": "A neighbouring county ran a two-year route-backed performance contract in which payment released only against quarterly measured geometry and travel-speed indices."
    },
    {
      "@id": "urn:conclave:cid:E4=E5",
      "conclave:evidenceId": "E5",
      "conclave:handling": "Public demo input; precedent value only.",
      "conclave:sensitivity": "public",
      "conclave:source": "Neighbouring county roads tender board summary",
      "conclave:sourceKind": "benchmark",
      "description": "The pilot's contracted enforcement used a third-party survey vehicle for speed-index runs with results published to the eSiasa portal each quarter."
    },
    {
      "@id": "urn:conclave:cid:E5=E6",
      "conclave:evidenceId": "E6",
      "conclave:handling": "Public demo input; shows repeat-failure geography.",
      "conclave:sensitivity": "public",
      "conclave:source": "eSiasa civic complaint intake dashboard",
      "conclave:sourceKind": "platform",
      "description": "Ward-level complaint intake logged 2,214 feeder-road reports in FY2025, of which 38% repeated within a kilometre of a previously patched segment."
    },
    {
      "@id": "urn:conclave:cid:E6=E7",
      "conclave:evidenceId": "E7",
      "conclave:handling": "Public demo input; binds any recommended contract design.",
      "conclave:sensitivity": "public",
      "conclave:source": "Siaya County public procurement manual",
      "conclave:sourceKind": "policy",
      "description": "County procurement rules require multi-year service contracts above the threshold value to carry measurable output clauses and independent verification."
    }
  ],
